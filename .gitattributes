# Normalise line endings in the repository; check out scripts for Unix tools with LF everywhere
# (a Windows checkout with core.autocrlf would otherwise break them in Git Bash or WSL).
* text=auto
*.sh text eol=lf
debian/rules text eol=lf
*.ps1 text eol=crlf
*.iss text eol=crlf

*.png binary
*.svg text
*.dll binary
